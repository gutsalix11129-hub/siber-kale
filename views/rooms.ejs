<div style="display: flex; justify-content: space-between; align-items: center;">
  <h1>Odalar</h1>
  <a href="/rooms/new"><button>+ Yeni Oda Kur</button></a>
</div>
<p class="muted">Kendi özel odanızı oluşturun veya herkese açık odalara katılın.</p>

<hr style="border: 1px solid #ddd; margin: 20px 0;">

<h2>Benim Odalarım</h2>
<% if (myRooms.length === 0) { %>
  <p>Henüz bir odanız yok. Hemen yeni bir tane oluşturun!</p>
<% } %>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px;">
  <% myRooms.forEach(r => { %>
    <article style="margin-bottom: 0;">
      <h3><a href="/rooms/<%= r.id %>" style="color: #0056b3; text-decoration: none;"><%= r.name %></a></h3>
      <p class="muted"><%= r.visibility === 'public' ? '🌍 Herkese Açık' : '🔒 Sadece Davetli' %></p>
      <p class="muted" style="font-size: 0.8em;">slug: <%= r.slug %></p>
    </article>
  <% }) %>
</div>

<hr style="border: 1px solid #ddd; margin: 30px 0;">

<h2>Keşfet (Herkese Açık Odalar)</h2>
<% if (publicRooms.length === 0) { %>
  <p>Şu an katılabileceğiniz başka bir herkese açık oda yok.</p>
<% } %>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px;">
  <% publicRooms.forEach(r => { %>
    <article style="margin-bottom: 0; background-color: #f0f8ff;">
      <h3><a href="/rooms/<%= r.id %>" style="color: #0056b3; text-decoration: none;"><%= r.name %></a></h3>
      <p class="muted"><%= r.description || 'Açıklama yok.' %></p>
      <a href="/rooms/<%= r.id %>"><button style="width: 100%; font-size: 0.9em; margin-top: 10px;">İncele ve Katıl</button></a>
    </article>
  <% }) %>
</div>