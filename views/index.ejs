<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-black text-white italic tracking-widest"><i class="fas fa-server text-primary mr-2"></i>SİSTEM PANELİ</h1>
  <% if(user) { %><a href="/new-thread" class="bg-primary text-black font-bold px-4 py-2 text-sm hover:bg-white transition neon-border"><i class="fas fa-plus mr-1"></i>YENİ KONU AÇ</a><% } %>
</div>

<div class="bg-panel border border-border overflow-hidden mb-6">
  <div class="bg-panelLight px-4 py-2 border-b border-border text-xs font-bold text-gray-300 font-mono tracking-widest uppercase">> Son Açılan Konular</div>
  <div class="divide-y divide-border">
    <% latestThreads.forEach(t => { %>
      <div class="flex justify-between items-center p-3 hover:bg-[#1a1a1a] transition font-mono">
        <div class="flex items-center gap-2"><i class="fas fa-angle-right text-primary"></i><a href="/thread/<%= t.id %>" class="text-sm text-gray-300 hover:text-primary transition truncate"><%= t.title %></a></div>
        <a href="/profile/<%= t.username %>" class="text-xs text-accent hover:underline"><%= t.username %></a>
      </div>
    <% }) %>
  </div>
</div>

<h2 class="text-lg font-bold text-white mb-3 font-mono tracking-widest"><i class="fas fa-folder-open text-accent mr-2"></i>FORUM KATEGORİLERİ</h2>
<div class="space-y-4">
  <% forums.forEach(forum => { %>
    <div class="bg-panel border border-border overflow-hidden shadow-sm neon-border">
      <div class="bg-panelLight px-4 py-2 border-b border-border font-bold text-white text-sm flex items-center gap-2 font-mono"><i class="fas <%= forum.icon %> text-primary"></i> [<%= forum.name.toUpperCase() %>]</div>
      <div class="flex flex-col md:flex-row items-center p-4 hover:bg-[#111] transition group">
        <div class="flex-1 flex items-center gap-4 w-full md:w-auto mb-4 md:mb-0">
          <div class="w-14 h-14 bg-black border border-border flex items-center justify-center flex-shrink-0 group-hover:border-primary transition"><i class="fas <%= forum.icon %> text-gray-500 text-2xl group-hover:text-primary transition"></i></div>
          <div>
            <a href="/forum/<%= forum.id %>" class="text-lg font-bold text-gray-200 hover:text-primary transition font-mono"><%= forum.name %></a>
            <p class="text-xs text-gray-500 mt-1 font-mono"><%= forum.description %></p>
          </div>
        </div>
        <div class="flex items-center gap-6 w-full md:w-auto justify-between md:justify-end border-t md:border-t-0 md:border-l border-border pt-4 md:pt-0 md:pl-6">
          <div class="text-center font-mono"><div class="text-sm font-bold text-white"><%= forum.threadCount %></div><div class="text-[10px] text-gray-500 uppercase">Konu</div></div>
          <div class="text-center font-mono"><div class="text-sm font-bold text-white"><%= forum.replyCount %></div><div class="text-[10px] text-gray-500 uppercase">Mesaj</div></div>
          <div class="text-right w-40 hidden md:block font-mono">
            <% if (forum.lastPost) { %>
              <a href="/thread/<%= forum.lastPost.id %>" class="text-xs text-primary truncate block hover:underline"><%= forum.lastPost.title %></a>
              <span class="text-[10px] text-gray-500"><%= forum.lastPost.username %></span>
            <% } else { %><span class="text-xs text-gray-600">-</span><% } %>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>