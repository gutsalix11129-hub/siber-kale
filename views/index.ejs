<div class="flex justify-between items-center mb-4">
  <h1 class="text-xl font-bold text-white"><i class="fas fa-home text-primary mr-2"></i>Forum Ana Sayfa</h1>
  <a href="/new-thread" class="bg-primary text-black px-4 py-2 rounded text-sm font-bold hover:bg-white transition"><i class="fas fa-plus mr-1"></i>Konu Aç</a>
</div>

<div class="space-y-4">
  <% forums.forEach(forum => { %>
    <div class="bg-panel rounded-lg border border-border overflow-hidden hover:border-primary transition flex flex-col md:flex-row items-center p-4 gap-4">
      <div class="w-12 h-12 bg-darkbg rounded-lg border border-border flex items-center justify-center flex-shrink-0"><i class="fas <%= forum.icon %> text-primary text-xl"></i></div>
      <div class="flex-1 text-center md:text-left">
        <a href="/forum/<%= forum.id %>" class="text-lg font-bold text-white hover:text-primary transition"><%= forum.name %></a>
        <p class="text-sm text-gray-400"><%= forum.description %></p>
      </div>
      <div class="flex gap-4 text-center">
        <div><div class="text-white font-bold"><%= forum.threadCount %></div><div class="text-xs text-gray-500">Konu</div></div>
        <div><div class="text-white font-bold"><%= forum.replyCount %></div><div class="text-xs text-gray-500">Mesaj</div></div>
      </div>
    </div>
  <% }) %>
</div>

<div class="mt-8 bg-panel rounded-lg border border-border overflow-hidden">
  <div class="bg-[#21262d] px-4 py-3 border-b border-border font-bold text-white text-sm"><i class="fas fa-clock text-primary mr-2"></i>Son Açılan Konular</div>
  <div class="divide-y divide-border">
    <% latestThreads.forEach(t => { %>
      <div class="p-3 hover:bg-[#1c2128] flex justify-between items-center">
        <a href="/thread/<%= t.id %>" class="text-sm text-gray-300 hover:text-primary truncate"><%= t.title %></a>
        <span class="text-xs text-gray-500 whitespace-nowrap ml-4"><%= t.username %></span>
      </div>
    <% }) %>
  </div>
</div>