<!doctype html>
<html lang="tr" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | NullSec</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/atom-one-dark.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>
  <script>hljs.highlightAll();</script>
  <script>tailwind.config = { darkMode: 'class', theme: { extend: { colors: { darkbg: '#0d1117', panel: '#161b22', border: '#30363d', primary: '#00ff41' } } } }</script>
  <style>body { background-color: #0d1117; color: #c9d1d9; } .markdown-body pre { padding: 0; border-radius: 6px; }</style>
</head>
<body class="antialiased font-sans">
  
  <nav class="bg-panel border-b border-border sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16">
      <a href="/" class="text-2xl font-black text-white tracking-widest">NULL<span class="text-primary">SEC</span></a>
      
      <!-- ARAMA -->
      <form action="/search" method="GET" class="hidden md:flex flex-1 max-w-md mx-6 relative">
        <input name="q" placeholder="Forumda ara..." class="w-full bg-darkbg border border-border rounded-full px-4 py-1.5 text-sm text-white focus:outline-none focus:border-primary">
        <button type="submit" class="absolute right-3 top-1.5 text-gray-400 hover:text-primary"><i class="fas fa-search"></i></button>
      </form>

      <div class="flex items-center space-x-4">
        <% if (user) { %>
          <!-- BİLDİRİMLER -->
          <a href="/notifications" class="relative text-gray-400 hover:text-primary transition">
            <i class="fas fa-bell text-lg"></i>
            <% if (unreadNotifs > 0) { %>
              <span class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full"><%= unreadNotifs %></span>
            <% } %>
          </a>
          <!-- MESAJLAR -->
          <a href="/messages" class="relative text-gray-400 hover:text-primary transition mr-2">
            <i class="fas fa-envelope text-lg"></i>
            <% if (unreadPMs > 0) { %>
              <span class="absolute -top-1 -right-1 bg-red-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full"><%= unreadPMs %></span>
            <% } %>
          </a>

          <a href="/profile/<%= user.username %>" class="flex items-center bg-darkbg px-3 py-1.5 rounded-full border border-border hover:border-primary transition">
            <div class="h-8 w-8 rounded-full bg-gray-700 flex items-center justify-center font-bold text-white mr-3"><%= user.username[0].toUpperCase() %></div>
            <div class="flex flex-col">
              <span class="text-sm font-bold text-white leading-tight"><%= user.username %></span>
              <% let rank = getRank(user.points); %>
              <span class="text-xs <%= rank.color %> leading-tight"><i class="fas <%= rank.icon %> mr-1"></i><%= rank.name %></span>
            </div>
          </a>
          <a href="/settings" class="text-gray-400 hover:text-white" title="Ayarlar"><i class="fas fa-cog"></i></a>
          <form method="post" action="/logout"><button type="submit" class="text-gray-400 hover:text-red-500"><i class="fas fa-sign-out-alt"></i></button></form>
        <% } else { %>
          <a href="/login" class="text-gray-300 hover:text-white text-sm font-medium">Giriş</a>
          <a href="/register" class="bg-primary text-black hover:bg-white px-4 py-2 rounded-md text-sm font-bold transition">Kayıt</a>
        <% } %>
      </div>
    </div>
  </nav>

  <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col md:flex-row gap-6">
    <!-- SOL MENÜ -->
    <aside class="w-full md:w-64 flex-shrink-0 space-y-4">
      <div class="bg-panel rounded-lg border border-border overflow-hidden">
        <div class="bg-[#21262d] px-4 py-3 border-b border-border font-bold text-white text-sm"><i class="fas fa-list text-primary mr-2"></i>Kategoriler</div>
        <div class="p-2 space-y-1">
          <% forums.forEach(f => { %>
            <a href="/forum/<%= f.id %>" class="block px-3 py-2 rounded-md text-sm text-gray-300 hover:bg-[#21262d] hover:text-primary"><i class="fas <%= f.icon %> text-gray-500 mr-2"></i><%= f.name %></a>
          <% }) %>
        </div>
      </div>
      <div class="bg-panel rounded-lg border border-border p-4 text-sm space-y-2">
        <div class="text-gray-400 mb-2 font-bold"><i class="fas fa-chart-pie text-primary mr-2"></i>İstatistikler</div>
        <div class="flex justify-between text-gray-400"><span>Üye:</span> <span class="text-white font-bold"><%= stats.users %></span></div>
        <div class="flex justify-between text-gray-400"><span>Konu:</span> <span class="text-white font-bold"><%= stats.posts %></span></div>
        <div class="flex justify-between text-gray-400"><span>Mesaj:</span> <span class="text-white font-bold"><%= stats.replies %></span></div>
      </div>
      <div class="bg-panel rounded-lg border border-border p-4 text-sm">
        <div class="text-gray-400 mb-2"><i class="fas fa-users text-primary mr-2"></i>Çevrimiçi (<%= onlineUsers.length %>)</div>
        <div class="flex flex-wrap gap-1">
          <% onlineUsers.forEach(u => { %><a href="/profile/<%= u.username %>" class="text-xs bg-darkbg border border-border px-2 py-1 rounded hover:border-primary"><%= u.username %></a><% }) %>
        </div>
      </div>
    </aside>

    <main class="flex-1 min-w-0"><%- body %></main>

    <!-- SAĞ MENÜ -->
    <aside class="w-full md:w-72 flex-shrink-0 space-y-4">
      <div class="bg-panel rounded-lg border border-border overflow-hidden">
        <div class="bg-[#21262d] px-4 py-3 border-b border-border font-bold text-white text-sm"><i class="fas fa-comments text-primary mr-2"></i>Shoutbox</div>
        <div class="p-3 h-48 overflow-y-auto space-y-2 text-sm flex flex-col justify-end">
          <% shoutbox.forEach(s => { %><div class="break-words"><span class="text-primary font-bold"><%= s.username %>:</span> <span class="text-gray-300"><%= s.message %></span></div><% }) %>
        </div>
        <% if (user) { %>
          <form method="post" action="/shoutbox" class="p-2 border-t border-border flex gap-2">
            <input name="message" placeholder="Mesaj..." required maxlength="100" class="flex-1 bg-darkbg border border-border rounded px-2 py-1.5 text-sm text-white focus:outline-none focus:border-primary">
            <button type="submit" class="text-primary hover:text-white"><i class="fas fa-paper-plane"></i></button>
          </form>
        <% } %>
      </div>
    </aside>
  </div>

  <footer class="border-t border-border mt-12 py-6 text-center text-gray-500 text-sm">
    <p>NullSec &copy; 2024 - Gelişmiş Siber Güvenlik Platformu.</p>
  </footer>
</body>
</html>