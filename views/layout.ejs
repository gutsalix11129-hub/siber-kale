<!doctype html>
<html lang="tr" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | NullSec</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = { darkMode: 'class', theme: { extend: { colors: { darkbg: '#0a0a0a', panel: '#121212', panelLight: '#1a1a1a', border: '#2d2d2d', primary: '#00ff41', accent: '#ff003c' } } } }
  </script>
  <style>
    body { background-color: #0a0a0a; color: #a3a3a3; font-family: 'Inter', sans-serif; }
    .forum-row:hover { background-color: #1a1a1a; }
    .markdown-body pre { background: #000; padding: 15px; border-radius: 6px; border: 1px solid #333; color: #00ff41; overflow-x: auto; }
  </style>
</head>
<body class="antialiased">
  
  <!-- ÜST BANT -->
  <div class="bg-black border-b border-border text-xs py-1.5 px-4 flex justify-between items-center text-gray-500">
    <div class="flex gap-4">
      <span><i class="fas fa-terminal text-primary mr-1"></i> NullSec Ağı</span>
    </div>
    <div class="flex gap-4">
      <% if (user) { %>
        <span>Hoş geldin, <a href="/profile/<%= user.username %>" class="text-primary hover:underline font-bold"><%= user.username %></a></span>
      <% } else { %>
        <a href="/login" class="hover:text-white">Giriş Yap</a>
        <a href="/register" class="hover:text-white">Kayıt Ol</a>
      <% } %>
    </div>
  </div>

  <!-- NAVBAR -->
  <nav class="bg-panel border-b border-border sticky top-0 z-50 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="text-3xl font-black text-white tracking-widest italic">NULL<span class="text-primary">SEC</span></a>
      
      <div class="flex-1 max-w-xl mx-8">
        <form action="/search" method="GET" class="relative">
          <input name="q" placeholder="Konu, mesaj veya kullanıcı ara..." class="w-full bg-[#0a0a0a] border border-border rounded-md px-4 py-2 text-sm text-white focus:outline-none focus:border-primary transition">
          <button type="submit" class="absolute right-2 top-2.5 text-gray-500 hover:text-primary"><i class="fas fa-search"></i></button>
        </form>
      </div>

      <div class="flex items-center space-x-5">
        <% if (user) { %>
          <a href="/notifications" class="relative text-gray-400 hover:text-primary transition">
            <i class="fas fa-bell text-xl"></i>
            <% if (unreadNotifs > 0) { %><span class="absolute -top-1.5 -right-1.5 bg-accent text-white text-[10px] font-bold px-1.5 rounded-full"><%= unreadNotifs %></span><% } %>
          </a>
          <a href="/messages" class="relative text-gray-400 hover:text-primary transition">
            <i class="fas fa-envelope text-xl"></i>
            <% if (unreadPMs > 0) { %><span class="absolute -top-1.5 -right-1.5 bg-accent text-white text-[10px] font-bold px-1.5 rounded-full"><%= unreadPMs %></span><% } %>
          </a>
          <a href="/profile/<%= user.username %>" class="flex items-center gap-3 border border-border rounded-full pl-1 pr-3 py-1 bg-[#1a1a1a] hover:border-primary transition">
            <img src="https://ui-avatars.com/api/?name=<%= user.username %>&background=000&color=00ff41" class="w-7 h-7 rounded-full">
            <span class="text-sm font-bold text-white"><%= user.username %></span>
          </a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- ANA İÇERİK -->
  <div class="max-w-7xl mx-auto px-4 py-6 flex flex-col md:flex-row gap-6">
    
    <main class="flex-1 min-w-0"><%- body %></main>

    <!-- SAĞ SİDEBAR -->
    <aside class="w-full md:w-80 flex-shrink-0 space-y-4">
      
      <!-- İSTATİSTİKLER -->
      <div class="bg-panel border border-border rounded-md overflow-hidden">
        <div class="bg-panelLight px-4 py-2.5 border-b border-border text-sm font-bold text-white flex items-center gap-2">
          <i class="fas fa-chart-line text-primary"></i> Forum İstatistikleri
        </div>
        <div class="p-3 text-sm space-y-2">
          <div class="flex justify-between border-b border-border pb-1"><span class="text-gray-500">Toplam Üye:</span> <span class="text-primary font-bold"><%= stats.users %></span></div>
          <div class="flex justify-between border-b border-border pb-1"><span class="text-gray-500">Toplam Konu:</span> <span class="text-primary font-bold"><%= stats.posts %></span></div>
          <div class="flex justify-between"><span class="text-gray-500">Toplam Mesaj:</span> <span class="text-primary font-bold"><%= stats.replies %></span></div>
        </div>
      </div>

      <!-- ÇEVRİMİÇİ -->
      <div class="bg-panel border border-border rounded-md overflow-hidden">
        <div class="bg-panelLight px-4 py-2.5 border-b border-border text-sm font-bold text-white flex items-center gap-2">
          <i class="fas fa-users text-primary"></i> Çevrimiçi Kullanıcılar
        </div>
        <div class="p-3 text-sm text-gray-400 flex flex-wrap gap-2">
          <% onlineUsers.forEach(u => { %>
            <a href="/profile/<%= u.username %>" class="hover:text-primary transition"><%= u.username %></a>,
          <% }) %>
        </div>
      </div>

      <!-- SHOUTBOX -->
      <div class="bg-panel border border-border rounded-md overflow-hidden">
        <div class="bg-panelLight px-4 py-2.5 border-b border-border text-sm font-bold text-white flex items-center gap-2">
          <i class="fas fa-comments text-primary"></i> Anlık Sohbet (Shoutbox)
        </div>
        <div class="p-3 h-56 overflow-y-auto space-y-1.5 text-sm flex flex-col justify-end custom-scrollbar">
          <% shoutbox.forEach(s => { %>
            <div class="break-words bg-[#0a0a0a] p-1.5 rounded"><span class="text-primary font-bold text-xs"><%= s.username %>:</span> <span class="text-gray-300"><%= s.message %></span></div>
          <% }) %>
        </div>
        <% if (user) { %>
          <form method="post" action="/shoutbox" class="p-2 border-t border-border flex gap-1">
            <input name="message" placeholder="Mesaj yaz..." required maxlength="100" class="flex-1 bg-[#0a0a0a] border border-border rounded px-2 py-1 text-sm text-white focus:outline-none focus:border-primary">
            <button type="submit" class="bg-primary text-black px-3 rounded hover:bg-white transition"><i class="fas fa-paper-plane"></i></button>
          </form>
        <% } %>
      </div>

    </aside>
  </div>

  <footer class="border-t border-border mt-10 py-6 text-center text-gray-600 text-xs">
    <p>NullSec &copy; 2024 - Gelişmiş Siber Güvenlik Platformu. Tüm hakları saklıdır.</p>
  </footer>
</body>
</html>