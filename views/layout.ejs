<!doctype html>
<html lang="tr" class="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | NullSec</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            darkbg: '#0d1117',
            panel: '#161b22',
            border: '#30363d',
            primary: '#00ff41',
          }
        }
      }
    }
  </script>
  <style>
    body { background-color: #0d1117; color: #c9d1d9; }
    .markdown-body pre { background: #010409; padding: 15px; border-radius: 6px; border: 1px solid #30363d; color: #00ff41; overflow-x: auto; }
    .markdown-body code { font-family: 'Courier New', monospace; }
  </style>
</head>
<body class="antialiased font-sans">
  
  <!-- NAVBAR -->
  <nav class="bg-panel border-b border-border sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <div class="flex items-center">
          <a href="/" class="text-2xl font-black text-white tracking-widest">
            NULL<span class="text-primary">SEC</span>
          </a>
        </div>
        <div class="hidden md:block">
          <div class="ml-10 flex items-baseline space-x-4">
            <a href="/" class="hover:text-primary px-3 py-2 rounded-md text-sm font-medium transition"><i class="fas fa-home mr-2"></i>Forum</a>
            <a href="/rooms" class="hover:text-primary px-3 py-2 rounded-md text-sm font-medium transition"><i class="fas fa-comments mr-2"></i>Odalar</a>
            <a href="/posts/new" class="hover:text-primary px-3 py-2 rounded-md text-sm font-medium transition"><i class="fas fa-plus-circle mr-2"></i>Konu Aç</a>
            <% if (user && user.role === 'admin') { %>
              <a href="/admin" class="text-red-500 hover:text-red-400 px-3 py-2 rounded-md text-sm font-bold transition"><i class="fas fa-shield-alt mr-2"></i>Admin</a>
            <% } %>
          </div>
        </div>
        
        <div class="flex items-center space-x-4">
          <% if (user) { %>
            <div class="flex items-center bg-darkbg px-3 py-1.5 rounded-full border border-border">
              <div class="h-8 w-8 rounded-full bg-gray-700 flex items-center justify-center font-bold text-white mr-3">
                <%= user.username ? user.username[0].toUpperCase() : 'U' %>
              </div>
              <div class="flex flex-col">
                <span class="text-sm font-bold text-white leading-tight"><%= user.username || user.email %></span>
                <% let rank = getRank(user.points || 0); %>
                <span class="text-xs <%= rank.color %> leading-tight"><i class="fas <%= rank.icon %> mr-1"></i><%= rank.name %></span>
              </div>
              <form method="post" action="/logout" class="ml-3">
                <button type="submit" class="text-gray-400 hover:text-red-500 transition"><i class="fas fa-sign-out-alt"></i></button>
              </form>
            </div>
          <% } else { %>
            <a href="/login" class="text-gray-300 hover:text-white px-3 py-2 text-sm font-medium">Giriş</a>
            <a href="/register" class="bg-primary text-black hover:bg-white px-4 py-2 rounded-md text-sm font-bold transition shadow-[0_0_10px_rgba(0,255,65,0.3)]">Kayıt Ol</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex flex-col md:flex-row gap-6">
    
    <!-- SIDEBAR -->
    <aside class="w-full md:w-64 flex-shrink-0 space-y-4">
      <div class="bg-panel rounded-lg border border-border overflow-hidden">
        <div class="bg-[#21262d] px-4 py-3 border-b border-border font-bold text-white text-sm">
          <i class="fas fa-bars mr-2 text-primary"></i>Kategoriler
        </div>
        <div class="p-2 space-y-1">
          <a href="/" class="block px-3 py-2 rounded-md text-sm text-gray-300 hover:bg-[#21262d] hover:text-primary"><i class="fas fa-globe text-gray-500 mr-2"></i>Genel Sohbet</a>
          <a href="#" class="block px-3 py-2 rounded-md text-sm text-gray-300 hover:bg-[#21262d] hover:text-primary"><i class="fas fa-bug text-red-500 mr-2"></i>Zafiyetler</a>
          <a href="#" class="block px-3 py-2 rounded-md text-sm text-gray-300 hover:bg-[#21262d] hover:text-primary"><i class="fas fa-flag text-blue-500 mr-2"></i>CTF Çözümleri</a>
          <a href="#" class="block px-3 py-2 rounded-md text-sm text-gray-300 hover:bg-[#21262d] hover:text-primary"><i class="fas fa-tools text-yellow-500 mr-2"></i>Araçlar</a>
        </div>
      </div>
    </aside>

    <!-- DYNAMIC BODY -->
    <main class="flex-1">
      <%- body %>
    </main>
  </div>

  <footer class="border-t border-border mt-12 py-8 text-center text-gray-500 text-sm">
    <p>NullSec &copy; 2024 - Yasalara saygılı siber güvenlik topluluğu.</p>
  </footer>
</body>
</html>