<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | SiberKale</title>
  <style>
    :root { --bg: #0d1117; --panel: #161b22; --border: #30363d; --text: #c9d1d9; --text-muted: #8b949e; --primary: #58a6ff; --danger: #f85149; --success: #238636; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; background-color: var(--bg); color: var(--text); max-width: 900px; margin: 0 auto; padding: 16px; line-height: 1.6; }
    header { display: flex; gap: 15px; align-items: center; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 24px; }
    header a { color: var(--primary); text-decoration: none; font-weight: 600; font-size: 0.95em; }
    header a:hover { text-decoration: underline; }
    .logo { font-size: 1.3em; font-weight: bold; color: #fff; letter-spacing: 1px; }
    .logo span { color: var(--success); }
    article { background-color: var(--panel); border: 1px solid var(--border); padding: 20px; margin-bottom: 16px; border-radius: 8px; }
    input, textarea, button { font: inherit; padding: 10px; margin: 4px 0; border: 1px solid var(--border); border-radius: 6px; background-color: var(--bg); color: var(--text); width: 100%; box-sizing: border-box; }
    input:focus, textarea:focus { border-color: var(--primary); outline: none; }
    button { background-color: var(--success); color: white; cursor: pointer; font-weight: bold; border: none; transition: 0.2s; }
    button:hover { background-color: #2ea043; }
    button.danger { background-color: var(--danger); }
    button.danger:hover { background-color: #da3633; }
    button.secondary { background-color: var(--border); }
    button.secondary:hover { background-color: #4b535d; }
    .muted { color: var(--text-muted); font-size: 0.85em; }
    .prewrap { white-space: pre-wrap; font-family: "Courier New", Courier, monospace; background: #000; padding: 15px; border-radius: 6px; border: 1px solid var(--border); overflow-x: auto; }
    footer { margin-top: 40px; border-top: 1px solid var(--border); padding-top: 16px; font-size: 0.85em; color: var(--text-muted); text-align: center; }
    .user-info { margin-left: auto; display: flex; align-items: center; gap: 10px; }
    .user-info button { width: auto; padding: 5px 10px; font-size: 0.8em; }
  </style>
</head>
<body>
  <header>
    <a href="/" class="logo">🛡️ Siber<span>Kale</span></a>
    <% if (user) { %>
      <a href="/">Akış</a>
      <a href="/rooms">Odalar</a>
      <a href="/posts/new">Paylaş</a>
      <% if (user.role === 'admin') { %><a href="/admin" style="color: var(--danger);">Admin</a><% } %>
      
      <div class="user-info">
        <span class="muted"><%= user.email %></span>
        <form method="post" action="/logout" style="display:inline">
          <button type="submit" class="danger">Çıkış</button>
        </form>
      </div>
    <% } else { %>
      <div style="margin-left: auto; display: flex; gap: 10px;">
        <a href="/login">Giriş</a>
        <a href="/register" style="color: var(--success);">Kayıt Ol</a>
      </div>
    <% } %>
  </header>

  <main>
    <%- body %>
  </main>

  <footer>
    SiberKale - Yasal Siber Güvenlik Topluluğu<br>
    <span class="muted">Etik hacking, savunma ve eğitim.</span>
  </footer>
</body>
</html>