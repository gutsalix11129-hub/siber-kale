<h1 class="text-xl font-bold text-white mb-6 font-mono"><i class="fas fa-plus-circle text-primary mr-2"></i>YENİ KONU OLUŞTUR</h1>

<form method="post" action="/new-thread" class="bg-panel border border-border p-6 space-y-4 neon-border">
  <div>
    <label class="block text-xs font-bold text-gray-400 mb-1 font-mono uppercase">Kategori Seç</label>
    <select name="forum_id" required class="w-full bg-black border border-border rounded-none px-3 py-2 text-white focus:outline-none focus:border-primary font-mono text-sm">
      <% forums.forEach(f => { %><option value="<%= f.id %>"><%= f.name %></option><% }) %>
    </select>
  </div>
  <div>
    <label class="block text-xs font-bold text-gray-400 mb-1 font-mono uppercase">Önek (İsteğe Bağlı)</label>
    <input name="prefix" placeholder="Örn: [Yardım], [Tartışma]" class="w-full bg-black border border-border rounded-none px-3 py-2 text-white focus:outline-none focus:border-primary font-mono text-sm">
  </div>
  <div>
    <label class="block text-xs font-bold text-gray-400 mb-1 font-mono uppercase">Başlık</label>
    <input name="title" required placeholder="Konu başlığını girin..." class="w-full bg-black border border-border rounded-none px-3 py-2 text-white focus:outline-none focus:border-primary font-mono text-sm">
  </div>
  <div>
    <label class="block text-xs font-bold text-gray-400 mb-1 font-mono uppercase">İçerik (Markdown Destekler)</label>
    <textarea name="body" required rows="10" placeholder="Kodunuzu veya sorununuzu buraya yazın..." class="w-full bg-black border border-border rounded-none px-3 py-2 text-primary focus:outline-none focus:border-primary font-mono text-sm"></textarea>
  </div>
  <button type="submit" class="bg-primary text-black font-bold px-6 py-2 hover:bg-white transition font-mono text-sm"><i class="fas fa-check mr-1"></i>SİSTEME GÖNDER</button>
</form>