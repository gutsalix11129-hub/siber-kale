<div class="min-h-[70vh] flex items-center justify-center py-8 font-mono">
  <div class="bg-panel p-8 border border-border w-full max-w-md neon-border">
    <div class="text-center mb-8">
      <i class="fas fa-user-secret text-4xl text-primary mb-3 neon-text"></i>
      <h2 class="text-xl font-bold text-white tracking-widest">> SISTEME_KAYIT</h2>
    </div>
    <% if (error) { %><div class="bg-danger/10 border border-danger text-danger px-4 py-2 mb-4 text-xs"><i class="fas fa-exclamation-triangle mr-1"></i> <%= error %></div><% } %>
    <form method="post" action="/register" class="space-y-4">
      <div><label class="block text-xs text-gray-400 mb-1">> KULLANICI ADI</label><input type="text" name="username" required class="w-full bg-black border border-border rounded-none px-4 py-2.5 text-white focus:outline-none focus:border-primary text-sm" placeholder="HackerIsmi"></div>
      <div><label class="block text-xs text-gray-400 mb-1">> E-POSTA</label><input type="email" name="email" required class="w-full bg-black border border-border rounded-none px-4 py-2.5 text-white focus:outline-none focus:border-primary text-sm" placeholder="ornek@mail.com"></div>
      <div><label class="block text-xs text-gray-400 mb-1">> ŞİFRE</label><input type="password" name="password" required class="w-full bg-black border border-border rounded-none px-4 py-2.5 text-white focus:outline-none focus:border-primary text-sm" placeholder="••••••••"></div>
      <button type="submit" class="w-full bg-primary text-black font-bold py-2.5 hover:bg-white transition mt-2">SİSTEME KAYDOL</button>
    </form>
    <p class="text-center text-gray-500 text-xs mt-6">Zaten üye misin? <a href="/login" class="text-primary hover:underline">Giriş Yap</a></p>
  </div>
</div>