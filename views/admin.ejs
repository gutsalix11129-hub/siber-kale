
<h1 class="text-xl font-bold text-danger mb-6 font-mono"><i class="fas fa-terminal mr-2"></i>ROOT_KONTROL_PANELI</h1>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-panel border border-border overflow-hidden neon-border">
    <div class="bg-panelLight px-4 py-2 border-b border-border text-xs font-bold text-white font-mono">> KULLANICI_YÖNETİMİ</div>
    <div class="divide-y divide-border h-96 overflow-y-auto">
      <% users.forEach(u => { %>
        <div class="p-3 flex justify-between items-center font-mono">
          <div>
            <span class="text-sm font-bold text-white"><%= u.username %></span>
            <span class="text-xs text-gray-500 block"><%= u.email %></span>
          </div>
          <% if (u.role !== 'admin') { %>
            <form method="post" action="/admin/user/<%= u.id %>/ban">
              <button type="submit" class="<%= u.is_banned ? 'bg-primary text-black' : 'bg-danger text-white' %> text-xs px-3 py-1 rounded-none font-bold"><%= u.is_banned ? 'BAN KALDIR' : 'BANLA' %></button>
            </form>
          <% } else { %><span class="text-xs text-danger font-bold">ROOT</span><% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="bg-panel border border-border overflow-hidden neon-border">
    <div class="bg-panelLight px-4 py-2 border-b border-border text-xs font-bold text-white font-mono">> KONU_YÖNETİMİ</div>
    <div class="divide-y divide-border h-96 overflow-y-auto">
      <% threads.forEach(t => { %>
        <div class="p-3 flex justify-between items-center font-mono">
          <span class="text-sm text-gray-300 truncate w-48"><%= t.title %></span>
          <div class="flex gap-2">
            <form method="post" action="/admin/thread/<%= t.id %>/pin">
              <button type="submit" class="text-xs px-2 py-1 rounded-none <%= t.is_pinned ? 'bg-primary text-black' : 'bg-[#21262d] text-white' %>"><i class="fas fa-thumbtack"></i></button>
            </form>
            <form method="post" action="/admin/thread/<%= t.id %>/lock">
              <button type="submit" class="text-xs px-2 py-1 rounded-none <%= t.is_locked ? 'bg-danger text-white' : 'bg-[#21262d] text-white' %>"><i class="fas fa-lock"></i></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>