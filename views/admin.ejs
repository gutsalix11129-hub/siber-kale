<h1 class="text-2xl font-bold text-white mb-6"><i class="fas fa-shield-alt text-red-500 mr-2"></i>Yönetici Paneli</h1>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <div class="bg-panel rounded-lg border border-border overflow-hidden">
    <div class="bg-[#21262d] px-4 py-3 border-b border-border font-bold text-white text-sm">Kullanıcı Yönetimi</div>
    <div class="divide-y divide-border h-96 overflow-y-auto">
      <% users.forEach(u => { %>
        <div class="p-3 flex justify-between items-center">
          <div>
            <span class="text-sm font-bold text-white"><%= u.username %></span>
            <span class="text-xs text-gray-500 block"><%= u.email %></span>
          </div>
          <% if (u.role !== 'admin') { %>
            <form method="post" action="/admin/user/<%= u.id %>/ban">
              <button type="submit" class="<%= u.is_banned ? 'bg-green-600' : 'bg-red-600' %> text-white text-xs px-3 py-1 rounded"><%= u.is_banned ? 'Yasağı Kaldır' : 'Banla' %></button>
            </form>
          <% } else { %>
            <span class="text-xs text-primary font-bold">Admin</span>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="bg-panel rounded-lg border border-border overflow-hidden">
    <div class="bg-[#21262d] px-4 py-3 border-b border-border font-bold text-white text-sm">Son Konular</div>
    <div class="divide-y divide-border h-96 overflow-y-auto">
      <% threads.forEach(t => { %>
        <div class="p-3 flex justify-between items-center">
          <span class="text-sm text-gray-300 truncate w-32"><%= t.title %></span>
          <div class="flex gap-2">
            <form method="post" action="/admin/thread/<%= t.id %>/pin">
              <button type="submit" class="text-xs px-2 py-1 rounded <%= t.is_pinned ? 'bg-primary text-black' : 'bg-gray-700 text-white' %>"><i class="fas fa-thumbtack"></i></button>
            </form>
            <form method="post" action="/admin/thread/<%= t.id %>/lock">
              <button type="submit" class="text-xs px-2 py-1 rounded <%= t.is_locked ? 'bg-red-500 text-white' : 'bg-gray-700 text-white' %>"><i class="fas fa-lock"></i></button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</div>